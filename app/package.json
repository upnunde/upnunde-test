{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3002",
    "dev:reset": "sh scripts/kill-dev-ports.sh && next dev --webpack --port 3002",
    "dev:webpack": "next dev --webpack --port 3002",
    "dev:turbo": "next dev --turbopack --port 3002",
    "setup:dev-host": "sh scripts/setup-dev-host.sh",
    "prebuild": "node scripts/verify-design-system-install.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint && npm run check:ds",
    "check:ds": "node scripts/verify-design-system-install.mjs && node scripts/check-design-system.mjs",
    "migrate:ds-foundation": "node scripts/migrate-ds-foundation.mjs",
    "migrate:ds-icons": "node scripts/migrate-ds-icons.mjs",
    "migrate:tokens": "node scripts/migrate-design-tokens.mjs",
    "sync:ds": "node scripts/sync-design-system-version.mjs",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@visactor/react-vchart": "^2.0.22",
    "@visactor/vchart": "^2.0.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "design-system": "github:upnunde/Renovel-Studio-DS#v0.1.16",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-textarea-autosize": "^8.5.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
